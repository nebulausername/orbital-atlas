{
  "name": "orbital-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive 3D solar system atlas: Newtonian N-body orbits from JPL Horizons state vectors, powers-of-ten zoom from the Milky Way to planetary interiors.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "node scripts/vitest-sauber.mjs run",
    "daten:horizons": "node scripts/fetch-horizons.mjs",
    "daten:sterne": "node scripts/fetch-stars.mjs",
    "daten:texturen": "node scripts/build-textures.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.62.1",
    "sharp": "^0.35.5",
    "typescript": "5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "three": "^0.186.1"
  }
}
